int check_register(char *reg, int line_number){
char *end;
long num;
if(reg[0] != '$'){
  fprintf(stderr, "Error in line %d: Invalid Register name\n", line_number);
  return -1;
}
num = strtol(reg + 1, &end, 10);
if(*end != '\0' || end == reg + 1){
  fprintf(stderr, "Error in line %d: Invalid Register name\n", line_number);
  return -1;
}
if(num<0 || num >31){
  fprintf(stderr, "Error in line %d: Invalid Register name\n", line_number);
  return -1;
}
return (int)num; 
}
