; ==============================================================================
; Test File 2: Master Negative Test (Comprehensive Syntax & Semantic Errors)
; ==============================================================================

; --- 1. Label Errors ---
1BADLABEL:  add     $1, $2, $3             ; Error: Label cannot start with a digit
THISLABELNAMEISWAYTOOLONGANDEXCEEDS31CHARS: sub $1, $2, $3 ; Error: Label exceeds 31 characters
add:        move    $1, $2                 ; Error: Label name cannot be a reserved instruction name
$1:         move    $1, $2                 ; Error: Label name cannot be a register name
.db:        move    $1, $2                 ; Error: Label name cannot be a directive name
DUPLABEL:   add     $1, $2, $3
DUPLABEL:   sub     $4, $5, $6             ; Error: Duplicate label definition

; --- 2. Extern & Entry Conflict Errors ---
            .extern EXTERNLABEL
EXTERNLABEL: add    $1, $2, $3             ; Error: Cannot define a label declared as extern
            .extern DUPLABEL               ; Error: Cannot declare local label as extern

; --- 3. Comma Syntax Errors ---
            add     , $1, $2, $3           ; Error: Illegal leading comma
            add     $1, , $2, $3           ; Error: Consecutive commas
            add     $1, $2, $3,            ; Error: Illegal trailing comma
            add     $1 $2 $3               ; Error: Missing commas between operands

; --- 4. Register Syntax & Range Errors ---
            add     $32, $1, $2            ; Error: Register out of range (max is $31)
            add     $-1, $1, $2            ; Error: Negative register number
            add     $abc, $1, $2           ; Error: Invalid register format
            add     $, $1, $2              ; Error: Missing register number after $
            add     1, $2, $3              ; Error: Missing $ prefix for register

; --- 5. Operand Count & Mismatch Errors ---
            add     $1, $2                 ; Error: Too few operands for 'add' (expects 3)
            add     $1, $2, $3, $4         ; Error: Too many operands for 'add'
            move    $1, $2, $3             ; Error: Too many operands for 'move' (expects 2)
            hlt     $1                     ; Error: 'hlt' takes no operands
            jmp                            ; Error: 'jmp' missing target operand
            UNKNOWNCMD $1, $2, $3          ; Error: Undefined instruction name

; --- 6. Immediate & Branch Range Errors ---
            addi    $1, 40000, $2          ; Error: Immediate value 40000 exceeds 16-bit range
            addi    $1, -40000, $2         ; Error: Immediate value -40000 exceeds 16-bit range
            addi    $1, 10.5, $2           ; Error: Floating point number not allowed

; --- 7. Data Directive Errors ---
            .db     128                    ; Error: 128 exceeds 8-bit signed range [-128, 127]
            .db     -129                   ; Error: -129 exceeds 8-bit signed range
            .dh     32768                  ; Error: 32768 exceeds 16-bit signed range [-32768, 32767]
            .dh     -32769                 ; Error: -32769 exceeds 16-bit signed range
            .dw     2147483648             ; Error: Exceeds 32-bit signed range
            .dw     5, , 6                 ; Error: Consecutive commas in data directive
            .dw     5, 6,                  ; Error: Trailing comma in data directive
            .asciz  Hello World"           ; Error: Missing opening quote in .asciz
            .asciz  "Hello World           ; Error: Missing closing quote in .asciz
            .asciz  "Hello" extra          ; Error: Extraneous text after closing quote
            .db                            ; Error: Missing arguments for directive
