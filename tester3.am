; === Test 3: Complex Symbol Flow, White Spaces and Externs ===

; Empty and commented lines to test parser robustness

    .extern GLOBALVAL
    .extern EXTERNALROUTINE
    
    .entry  LONGLABELNAMEFORTESTING31CHARA
